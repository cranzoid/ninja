# Database
DATABASE_URL=postgresql://localhost:5432/trading_platform_dev

# AWS
AWS_REGION=ap-south-1

# Platform mode: paper | shadow-live | live
MODE=paper

# Must be explicitly set to true to enable live trading
ARMED_LIVE=false

# Zerodha Kite Connect (Phase 7)
ZERODHA_API_KEY=your_api_key
ZERODHA_API_SECRET=your_api_secret
ZERODHA_REQUEST_TOKEN=your_request_token

# Config checksum — SHA256 of config snapshot (Phase 7, required for live mode)
CONFIG_CHECKSUM=

# Live capital cap (Phase 7)
LIVE_CAPITAL_INR=50000

# Logging
LOG_LEVEL=INFO
