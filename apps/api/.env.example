# Indian Trading Platform — Backend API Environment Variables
# Copy to .env and fill in values before running.

# --- Core ---
DATABASE_URL=postgresql://localhost:5432/trading_platform_dev
MODE=paper                    # paper | shadow-live | live
ARMED_LIVE=false             # Must be true for live trading
LOG_LEVEL=INFO

# --- Model Router — Provider Keys ---
# Not required in paper mode (fixture provider is used automatically)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# --- AWS Bedrock — Primary LLM provider (charter §7.5) ---
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are standard boto3 env vars.
# Set these in your environment or use an IAM role if running on EC2/ECS.
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Bedrock model IDs (defaults shown) — only used if AWS_REGION is set
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Model Router — Role → Provider Mapping ---
# Options: anthropic, openai, fixture
MODEL_ROLE_BLOCKER_SCAN_PRIMARY=anthropic
MODEL_ROLE_BLOCKER_SCAN_FALLBACK=openai
MODEL_ROLE_TRADE_CARD_PRIMARY=anthropic
MODEL_ROLE_TRADE_CARD_FALLBACK=openai
MODEL_ROLE_EXPLANATION_PRIMARY=openai
MODEL_ROLE_EXPLANATION_FALLBACK=anthropic

# --- Model Router — Provider Settings ---
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2

# In paper mode, FixtureProvider is always used regardless of above.
# AWS credentials and API keys are only needed for shadow-live and live modes.
# Bedrock is primary if AWS_REGION is set; otherwise Anthropic is primary.

# --- Phase 6: Shadow Live / Broker ---
# Required for shadow-live and live modes
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here
STATIC_IP_WHITELIST=                # Static IP for broker whitelist

# --- Phase 6: Compliance Gate ---
KILL_SWITCH=false                   # Set to true to block live arming
CONFIG_CHECKSUM=                    # SHA256 checksum of config (optional, for drift detection)
